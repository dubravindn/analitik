# Конфигурация Hermes. Скопировать в .env и заполнить. .env в git НЕ попадает.

# Токен МойСклад (только чтение). Bearer-токен из Настройки → Токены.
MOYSKLAD_TOKEN=

# Подключение к PostgreSQL. Формат: postgresql://пользователь:пароль@хост:порт/база
DATABASE_URL=postgresql://hermes:ПАРОЛЬ@127.0.0.1:5432/hermes

# Telegram (понадобится на этапе доставки отчётов; сейчас можно пусто)
TELEGRAM_BOT_TOKEN=
# Личные ID руководителей и получатели ежедневных отчётов — через запятую.
# Пример: 111111111,222222222
TELEGRAM_CHAT_ID=
# Единственная разрешённая закрытая группа. Ежедневные PDF туда автоматически
# не дублируются; ответы на групповые вопросы отправляются в саму группу.
TELEGRAM_GROUP_CHAT_ID=

# Закрытый управленческий дашборд. Секрет синхронизации генерируется при
# развёртывании и не должен совпадать с токенами Telegram или МойСклад.
DASHBOARD_URL=
DASHBOARD_SYNC_TOKEN=

# AI-аналитик через Codex CLI и действующую подписку ChatGPT.
# shadow — анализировать и сохранять, но не отправлять в Telegram (первые 7 дней).
# live — отправлять проверенную короткую сводку после PDF; off — полностью выключить.
AI_ANALYST_MODE=shadow
# Не задавать без необходимости: по умолчанию используется модель подписки Codex.
AI_CODEX_MODEL=
