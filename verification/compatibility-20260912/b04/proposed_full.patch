+def _source_refresh(payload: object) -> dict | None:
+    """Keep delivery metadata without copying business facts into the result."""
+    if not isinstance(payload, dict):
+        return None
+    source = payload.get("live_source")
+    if not isinstance(source, dict):
+        return None
+    return {
+        key: source.get(key)
+        for key in ("requested", "refreshed", "errors", "refreshed_at")
+    }
+
+
+def _transport_fields(job: object, run_id: str) -> dict:
+    """Preserve the address and source state on both success and failure."""
+    job = job if isinstance(job, dict) else {}
+    payload = job.get("payload")
+    payload = payload if isinstance(payload, dict) else {}
+    return {
+        "run_id": run_id,
+        "chat_id": str(job.get("chat_id") or ""),
+        "thread_id": str(job.get("thread_id") or ""),
+        "source_refresh": _source_refresh(payload),
+        "mode": job.get("mode", "shadow"),
+        "report_type": payload.get("report_type"),
+        "report_id": payload.get("report_id"),
+    }
