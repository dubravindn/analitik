{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "report_id", "report_type", "findings", "positive_changes", "data_warnings"],
  "properties": {
    "status": {"type": "string", "enum": ["ok", "insufficient_data"]},
    "report_id": {"type": "string"},
    "report_type": {"type": "string", "enum": ["period", "current_state", "forecast", "daily"]},
    "findings": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "title", "fact_ids", "evidence", "why_it_matters", "action"],
        "properties": {
          "severity": {"type": "string", "enum": ["critical", "warning", "info"]},
          "title": {"type": "string", "maxLength": 140},
          "fact_ids": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string"}},
          "evidence": {"type": "string", "maxLength": 500},
          "why_it_matters": {"type": "string", "maxLength": 400},
          "action": {"type": "string", "maxLength": 300}
        }
      }
    },
    "positive_changes": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "fact_ids"],
        "properties": {
          "title": {"type": "string", "maxLength": 140},
          "fact_ids": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string"}}
        }
      }
    },
    "data_warnings": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "fact_ids"],
        "properties": {
          "title": {"type": "string", "maxLength": 140},
          "fact_ids": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string"}}
        }
      }
    }
  }
}
