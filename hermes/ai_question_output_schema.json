{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "report_id", "report_type", "answer", "fact_ids", "caveats", "follow_up"],
  "properties": {
    "status": {"type": "string", "enum": ["ok", "insufficient_data"]},
    "report_id": {"type": "string"},
    "report_type": {"type": "string", "const": "question"},
    "answer": {"type": "string", "minLength": 1, "maxLength": 1600},
    "fact_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {"type": "string"}
    },
    "caveats": {
      "type": "array",
      "maxItems": 3,
      "items": {"type": "string", "maxLength": 240}
    },
    "follow_up": {"type": "string", "maxLength": 240}
  }
}
