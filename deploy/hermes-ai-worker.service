[Unit]
Description=Hermes AI analyst worker (Codex subscription)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hermes-ai
Group=hermes-ai
WorkingDirectory=/var/lib/hermes-ai/app
StateDirectory=hermes-ai
StateDirectoryMode=0770
UMask=0007
Environment=CODEX_HOME=/var/lib/hermes-ai/.codex
Environment=CODEX_BIN=/var/lib/hermes-ai/.local/bin/codex
Environment=AI_SPOOL_DIR=/var/lib/hermes-ai/spool
Environment=AI_CODEX_WORKDIR=/tmp
Environment=AI_CODEX_TIMEOUT=300
ExecStart=/usr/bin/python3 -m hermes.ai_worker
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/hermes-ai
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-ai-worker

[Install]
WantedBy=multi-user.target
