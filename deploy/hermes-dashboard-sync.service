[Unit]
Description=Hermes read-only dashboard snapshot
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/hermes/app
EnvironmentFile=/opt/hermes/.env
ExecStartPre=/usr/bin/install -d -m 0700 /opt/hermes/dashboard
ExecStart=/opt/hermes/venv/bin/python -m hermes.dashboard_snapshot --output /opt/hermes/dashboard/latest.json
TimeoutStartSec=10min
Nice=10
