{
  gateway: {
    mode: "local",
    bind: "loopback",
    port: 18789,
    auth: { mode: "token" },
    http: {
      endpoints: {
        chatCompletions: { enabled: true }
      }
    }
  },
  agents: {
    defaults: {
      workspace: "/var/lib/openclaw/workspace",
      model: { primary: "openai/gpt-5.6-sol" }
    }
  },
  tools: {
    deny: [
      "exec", "process", "read", "write", "edit", "apply_patch",
      "browser", "web_search", "web_fetch", "gateway", "cron",
      "message", "sessions_spawn", "sessions_send"
    ]
  }
}
