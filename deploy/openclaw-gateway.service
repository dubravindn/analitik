[Unit]
Description=OpenClaw private AI gateway for Hermes
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openclaw
Group=openclaw
WorkingDirectory=/var/lib/openclaw
Environment=HOME=/var/lib/openclaw
Environment=PATH=/opt/openclaw/bin:/opt/openclaw-node/bin:/usr/bin:/bin
EnvironmentFile=/etc/openclaw/gateway.env
ExecStart=/opt/openclaw/bin/openclaw gateway run --port 18789 --bind loopback --auth token
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/openclaw
UMask=0077
StandardOutput=journal
StandardError=journal
SyslogIdentifier=openclaw-gateway

[Install]
WantedBy=multi-user.target
